#!/usr/bin/env bash
set -euo pipefail

INPUT_DIR=""
OUTPUT_DIR=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -input|--input)
      INPUT_DIR="${2:-}"
      shift 2
      ;;
    -output|--output)
      OUTPUT_DIR="${2:-}"
      shift 2
      ;;
    *)
      # The evaluator may pass additional arguments.
      shift
      ;;
  esac
done

if [[ -z "$INPUT_DIR" || -z "$OUTPUT_DIR" ]]; then
  echo "Error: -input and -output are required" >&2
  echo "Usage: $0 -input <input directory> -output <output directory>" >&2
  exit 2
fi

if [[ ! -d "$INPUT_DIR" ]]; then
  echo "Error: input directory does not exist: $INPUT_DIR" >&2
  exit 3
fi

mkdir -p "$OUTPUT_DIR" || {
  echo "Error: cannot create output directory: $OUTPUT_DIR" >&2
  exit 3
}

cd /submission
exec python3 -B main.py -input "$INPUT_DIR" -output "$OUTPUT_DIR"
